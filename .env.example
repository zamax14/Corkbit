# Docker Compose: cp .env.example .env; asigna un token antes de iniciar.
AGENT_TOKEN=replace-with-a-random-local-secret
POSTGRES_PASSWORD=corkbit-local
WEB_PORT=8080
# Debe ser accesible desde el teléfono para que funcione el QR.
PUBLIC_BASE_URL=http://localhost:8080
WIP_LIMIT=5
PRINT_MAX_ATTEMPTS=3
# file genera tickets ESC/POS de prueba, network usa una impresora LAN,
# device usa la impresora USB que el kernel expone en PRINT_DEVICE.
PRINT_TRANSPORT=file
PRINT_DEVICE=/dev/usb/lp0
PRINT_HOST=
PRINT_PORT=9100
PRINT_PROFILE=TM-T88III

# Keycloak. La consola de administracion solo se publica dentro de la tailnet.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-secret
KEYCLOAK_PORT=8081
# URL publica del realm (la que ven navegador y ChatGPT) y la privada de la consola.
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_ADMIN_URL=http://localhost:8081
# Sin OIDC_ISSUER la API no valida tokens y rechaza todo: configuralo antes de desplegar.
OIDC_ISSUER=http://localhost:8081/realms/corkbit
OIDC_AUDIENCE=corkbit-api
MCP_BASE_URL=

# --- Despliegue publico con dominio propio (`just up-public`). Ver docs/deploy-vps.md ---
# Vacias en local y en Tailscale; Caddy solo arranca con el perfil `public`.
CORKBIT_DOMAIN=
KEYCLOAK_DOMAIN=
ACME_EMAIL=
# Con Caddy delante, los puertos 8080 y 8081 dejan de publicarse en la red:
# la unica puerta es HTTPS. En local dejalos vacios para llegar desde el movil.
WEB_BIND=
KEYCLOAK_BIND=
