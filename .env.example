# Docker Compose: cp .env.example .env; asigna un token antes de iniciar.
AGENT_TOKEN=replace-with-a-random-local-secret
POSTGRES_PASSWORD=crokbit-local
WEB_PORT=8080
# Debe ser accesible desde el teléfono para que funcione el QR.
PUBLIC_BASE_URL=http://localhost:8080
WIP_LIMIT=5
PRINT_MAX_ATTEMPTS=3
# file genera tickets ESC/POS de prueba, network usa una impresora LAN.
PRINT_TRANSPORT=file
PRINT_HOST=
PRINT_PORT=9100
PRINT_PROFILE=TM-T88III

# Keycloak. La consola de administracion solo se publica dentro de la tailnet.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-secret
KEYCLOAK_PORT=8081
# URL publica del realm (la que ven navegador y ChatGPT) y la privada de la consola.
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_ADMIN_URL=http://localhost:8081
# Sin OIDC_ISSUER la API no valida tokens y rechaza todo: configuralo antes de desplegar.
OIDC_ISSUER=http://localhost:8081/realms/crokbit
OIDC_AUDIENCE=crokbit-api
MCP_BASE_URL=
