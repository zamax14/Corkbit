PRINT_API_URL=http://localhost:8000
PRINT_AGENT_ID=office-agent
PRINT_AGENT_TOKEN=replace-with-a-random-local-secret
PRINT_PRINTER_ID=1
PRINT_TRANSPORT=file
# transport=device: ruta del dispositivo que crea usblp (ls /dev/usb/lp*).
PRINT_DEVICE=/dev/usb/lp0
PRINT_HOST=
PRINT_PORT=9100
# IDs USB en decimal; valores de ejemplo Epson 0x04b8 / 0x0202.
PRINT_USB_VENDOR=1208
PRINT_USB_PRODUCT=514
PRINT_PROFILE=TM-T88III
PRINT_COLUMNS=48
PRINT_POLL_SECONDS=3
PRINT_OUTPUT_DIR=./tickets
PRINT_STATE_DIR=./agent-state
