DATABASE_URL=sqlite:///./corkbit.db
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
WIP_LIMIT=5
AGENT_TOKEN=replace-with-a-random-local-secret

# La API valida cada peticion contra Keycloak y no tiene modo "sin autenticacion":
# sin OIDC_ISSUER toda ruta responde 401. Levanta el realm con `just up` y deja
# estos valores tal cual; apuntan al Keycloak que publica Compose en el 8081.
OIDC_ISSUER=http://localhost:8081/realms/corkbit
OIDC_AUDIENCE=corkbit-api
OIDC_CLIENT_ID=corkbit-web
# URL publica del servidor MCP; solo hace falta para el registro dinamico de clientes.
MCP_BASE_URL=

PRINT_MAX_ATTEMPTS=3
PRINT_LEASE_SECONDS=120
